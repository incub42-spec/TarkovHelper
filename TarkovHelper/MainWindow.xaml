<Window x:Class="TarkovHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico"
        Title="Tarkov Helper — квесты, убежище и лут"
        Width="980" Height="680"
        Background="#FFF7F8FA" Foreground="#FF15181B"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- строка гаснет, когда нужное количество уже лежит в схроне -->
        <Style x:Key="EnoughRowStyle" TargetType="ListViewItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enough}" Value="True">
                    <Setter Property="Background" Value="#FFE8F5E9"/>
                    <Setter Property="Foreground" Value="#FF2E7D32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
  <DockPanel>
    <!-- панель профиля: какой персонаж и режим активны сейчас -->
    <!-- панель тёмная, поэтому текст на ней задаём светлым: иначе подписи
         сливаются с фоном -->
    <Border DockPanel.Dock="Top" Background="#1A2A33" Padding="10,7" Margin="6,6,6,0"
            CornerRadius="4" TextElement.Foreground="#FFE6ECF1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Профиль:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <ComboBox x:Name="CmbProfile" Width="180" Margin="8,0,0,0"
                  SelectionChanged="OnProfileSelected"/>
        <Border x:Name="BadgeMode" Margin="10,0,0,0" Padding="8,2" CornerRadius="3"
                Background="#2E7D32">
          <TextBlock x:Name="TxtModeBadge" Text="PvE" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- данные профиля только показываются; правятся в окне редактирования -->
        <TextBlock x:Name="TxtProfileInfo" VerticalAlignment="Center" Margin="12,0,0,0"
                   Opacity="0.85"/>
        <TextBlock x:Name="TxtLevelSaved" VerticalAlignment="Center" Margin="8,0,0,0"
                   Foreground="#FF81C784" FontWeight="SemiBold" Visibility="Collapsed"
                   Text="сохранено"/>

        <Button x:Name="BtnEditProfile" Content="Редактировать" Width="130" Margin="12,0,0,0"
                Click="OnEditProfileClick"
                ToolTip="Имя, фракция и уровень этого профиля"/>
        <!-- редкие операции убраны под «⋯», чтобы шапка не пестрила кнопками -->
        <Button x:Name="BtnProfileMenu" Content="⋯" Width="34" Margin="6,0,0,0"
                FontWeight="Bold" Click="OnProfileMenuClick"
                ToolTip="Добавить, переименовать или удалить профиль">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Добавить профиль…" Click="OnAddProfileClick"/>
              <MenuItem Header="Переименовать…" Click="OnRenameProfileClick"/>
              <Separator/>
              <MenuItem x:Name="MenuDeleteProfile" Header="Удалить профиль" Click="OnDeleteProfileClick"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </Border>

    <TabControl x:Name="Tabs" Margin="6" SelectionChanged="OnTabChanged">

        <TabItem x:Name="TabItems" Header="Что собирать">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <!-- три источника потребности и два уточнения к ним:
                         снятые галочки убирают строки целиком, поэтому если
                         снять все три — список пуст, и это честно -->
                    <CheckBox x:Name="ChkHideEnough" DockPanel.Dock="Right" VerticalAlignment="Center"
                              Margin="12,0,0,0" Content="Скрыть собранное"
                              Checked="OnItemScopeChanged" Unchecked="OnItemScopeChanged"
                              ToolTip="Убрать строки, где нужное количество уже лежит в схроне"/>
                    <CheckBox x:Name="ChkOnlyNow" DockPanel.Dock="Right" VerticalAlignment="Center"
                              Margin="12,0,0,0" IsChecked="True"
                              Content="Только нужное сейчас"
                              Checked="OnItemScopeChanged" Unchecked="OnItemScopeChanged"
                              ToolTip="Из отмеченных источников оставить выданные квесты, ближайшие уровни станций и обмены по достигнутой лояльности"/>
                    <!-- слева — что вообще показывать, справа — как это сузить -->
                    <Border DockPanel.Dock="Right" Width="1" Margin="14,3,2,3"
                            Background="#FFC8CDD3"/>
                    <CheckBox x:Name="ChkBarters" DockPanel.Dock="Right" VerticalAlignment="Center"
                              Margin="12,0,0,0" Content="Обмены"
                              Checked="OnItemScopeChanged" Unchecked="OnItemScopeChanged"
                              ToolTip="Предметы, которые торговцы принимают в обмен"/>
                    <CheckBox x:Name="ChkHideoutItems" DockPanel.Dock="Right" VerticalAlignment="Center"
                              Margin="12,0,0,0" IsChecked="True" Content="Убежище"
                              Checked="OnItemScopeChanged" Unchecked="OnItemScopeChanged"
                              ToolTip="Предметы для постройки станций"/>
                    <CheckBox x:Name="ChkQuestItems" DockPanel.Dock="Right" VerticalAlignment="Center"
                              Margin="12,0,0,0" IsChecked="True" Content="Квесты"
                              Checked="OnItemScopeChanged" Unchecked="OnItemScopeChanged"
                              ToolTip="Предметы для сдачи по заданиям"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="12,0,0,0" Text="Нужны для:" Opacity="0.7"/>
                    <TextBox x:Name="TxtItemSearch" Margin="0,0,12,0"
                             VerticalContentAlignment="Center"
                             TextChanged="OnItemSearchChanged"
                             ToolTip="Поиск по названию предмета"/>
                </DockPanel>
                <!-- клик по заголовку сортирует; ключ сортировки берётся из
                     привязки столбца, см. SortKeyFor в коде -->
                <ListView x:Name="ItemsList" Background="White" Foreground="#FF15181B"
                          GridViewColumnHeader.Click="OnColumnHeaderClick"
                          MouseDoubleClick="OnItemRowActivated"
                          KeyDown="OnItemListKeyDown"
                          ToolTip="Двойной клик по строке — все квесты, постройки и обмены, ради которых предмет нужен">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Предмет" Width="330"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <!-- сколько уже лежит в схроне и сколько осталось найти -->
                            <GridViewColumn Header="Есть" Width="60"
                                            DisplayMemberBinding="{Binding HaveText}"/>
                            <GridViewColumn Header="Осталось" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LeftText}"
                                                   Foreground="{Binding LeftBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Для квестов" Width="100"
                                            DisplayMemberBinding="{Binding QuestText}"/>
                            <GridViewColumn Header="из них FIR" Width="90"
                                            DisplayMemberBinding="{Binding FirText}"/>
                            <GridViewColumn Header="Убежище" Width="90"
                                            DisplayMemberBinding="{Binding HideoutText}"/>
                            <GridViewColumn Header="Обмены" Width="80"
                                            DisplayMemberBinding="{Binding BarterText}"/>
                            <GridViewColumn Header="Барахолка" Width="100"
                                            DisplayMemberBinding="{Binding PriceText}"/>
                            <GridViewColumn Header="Торговец" Width="140"
                                            DisplayMemberBinding="{Binding TraderPriceText}"/>
                            <GridViewColumn Header="Источники" Width="600"
                                            DisplayMemberBinding="{Binding Sources}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <TabItem Header="Квесты">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <!-- выполненных сотни, и смотрят их редко — отдельным окном,
                         а не пятой вкладкой -->
                    <Button x:Name="BtnCompleted" DockPanel.Dock="Right" Width="160" Margin="0,0,12,0"
                            Content="Выполненные…" Click="OnShowCompletedClick"/>
                    <Button x:Name="BtnAllQuests" DockPanel.Dock="Right" Width="140" Margin="0,0,12,0"
                            Content="Все квесты…" Click="OnShowAllQuestsClick"
                            ToolTip="Полный список, включая закрытые и выполненные"/>
                    <Button x:Name="BtnUndoScan" DockPanel.Dock="Right" Width="210" Margin="0,0,12,0"
                            Visibility="Collapsed" Click="OnUndoQuestScanClick"
                            ToolTip="Снять отметки, поставленные последним сканированием списка"/>
                    <!-- строки, которые сканирование прочитало, но не нашло в базе -->
                    <Button x:Name="BtnUnmatched" DockPanel.Dock="Right" Width="180" Margin="0,0,12,0"
                            Visibility="Collapsed" Click="OnUnmatchedClick"
                            ToolTip="Связать прочитанные строки с квестами: в базе они называются по-старому"/>
                    <Button x:Name="BtnTraders" DockPanel.Dock="Right" Width="130" Margin="0,0,12,0"
                            Content="Торговцы…" Click="OnTradersClick"
                            ToolTip="Уровни лояльности и репутация: по ним отсекаются квесты, которых торговец пока не даёт"/>
                    <TextBox x:Name="TxtQuestSearch" Margin="0,0,12,0"
                             VerticalContentAlignment="Center"
                             TextChanged="OnQuestFilterChanged"
                             ToolTip="Поиск по названию квеста или торговцу"/>
                </DockPanel>
                <!-- в базе tarkov.dev только побочные задания торговцев; сюжетные
                     главы и оперативные туда не попадают, и это надо сказать явно,
                     иначе выглядит так, будто программа потеряла квесты -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="Здесь только доступные квесты: те, у кого сданы все предыдущие в цепочке и хватает уровня. Закрытые и выполненные — по кнопке «Все квесты…». В базе побочные задания торговцев; сюжетных глав и оперативных в источнике нет."/>
                    <!-- главная причина, почему список длиннее, чем в игре:
                         сданные квесты программа знает только из сканирования -->
                    <TextBlock x:Name="TxtQuestKnowledge" TextWrapping="Wrap" Opacity="0.7"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <!-- по локации видно, что можно закрыть за один рейд -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Локация:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbQuestMap" Width="200" HorizontalAlignment="Left"
                              SelectionChanged="OnQuestMapChanged"
                              ToolTip="Оставить только задания этой локации"/>
                </DockPanel>
                <!-- та же галочка, что в игре: разложить по уровням лояльности -->
                <CheckBox x:Name="ChkGroupQuests" DockPanel.Dock="Top" Margin="0,0,0,8"
                          Content="Группировать по разделам, как в игре"
                          Checked="OnGroupQuestsChanged" Unchecked="OnGroupQuestsChanged"
                          ToolTip="Уровни лояльности торговца и «Ключевые». Разделы читаются при сканировании списка (F11) в сгруппированном виде"/>
                <!-- вкладки торговцев: переключают список, не трогая поиск -->
                <ItemsControl x:Name="TraderTabs" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Traders" Content="{Binding}"
                                         Style="{StaticResource {x:Type ToggleButton}}"
                                         Margin="0,0,4,4" Padding="10,3"
                                         Checked="OnTraderTabChecked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- описание выбранного квеста: у списка без него не видно, что делать -->
                <Border DockPanel.Dock="Right" Width="330" Margin="8,0,0,0" Padding="10"
                        Background="#F2F4F6" BorderBrush="#D8DEE4" BorderThickness="1"
                        TextElement.Foreground="#FF15181B"
                        CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="TxtQuestTitle" FontWeight="SemiBold" FontSize="14"
                                       TextWrapping="Wrap" Text="Выберите квест в списке"/>
                            <TextBlock x:Name="TxtQuestMeta" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Opacity="0.75"/>
                            <TextBlock x:Name="TxtQuestDesc" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtQuestObjTitle" Margin="0,12,0,4" FontWeight="SemiBold"
                                       Text="Задачи:" Visibility="Collapsed"/>
                            <ItemsControl x:Name="QuestObjectives">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TxtQuestChain" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Opacity="0.75"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <ListView x:Name="QuestsList" Background="White" Foreground="#FF15181B"
                          SelectionChanged="OnQuestSelected" SelectionMode="Extended"
                          GridViewColumnHeader.Click="OnColumnHeaderClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Переименовать квест…" Click="OnRenameQuestClick"/>
                            <Separator/>
                            <!-- можно выделить сразу несколько строк -->
                            <MenuItem Header="Торговец их не предлагает" Click="OnNotIssuedClick"
                                      ToolTip="Убрать из доступных, не отмечая сданными"/>
                            <MenuItem Header="Вернуть в доступные" Click="OnIssuedClick"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <!-- заголовки разделов включаются галочкой выше -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Margin="4,10,0,4" Foreground="#FF3A4652"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Выполнен" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- столбец убирается, когда торговец выбран кнопкой:
                                 повторять его в каждой строке незачем -->
                            <GridViewColumn x:Name="ColQuestTrader" Header="Торговец" Width="110"
                                            DisplayMemberBinding="{Binding Trader}"/>
                            <GridViewColumn Header="Квест" Width="330"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Локация" Width="130"
                                            DisplayMemberBinding="{Binding Map}"/>
                            <GridViewColumn Header="Фракция" Width="70"
                                            DisplayMemberBinding="{Binding Faction}"/>
                            <GridViewColumn Header="Статус" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Уровень" Width="70"
                                            DisplayMemberBinding="{Binding Level}"/>
                            <GridViewColumn Header="Каппа" Width="60"
                                            DisplayMemberBinding="{Binding Kappa}"/>
                            <GridViewColumn Header="Отмечен" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CheckedAt}"
                                                   Foreground="{Binding CheckedBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <!-- схрон: сколько нужного уже накоплено -->
        <TabItem Header="Схрон">
            <DockPanel Margin="10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               Margin="0,0,8,0" Opacity="0.7" Text="Найти предмет:"/>
                    <CheckBox x:Name="ChkStashOnlyHave" DockPanel.Dock="Right" VerticalAlignment="Center"
                              Margin="12,0,0,0" Content="Только то, что есть"
                              Checked="OnStashFilterChanged" Unchecked="OnStashFilterChanged"
                              ToolTip="Оставить строки, где количество больше нуля"/>
                    <!-- разделы справочника — те же, по которым игра раскладывает
                         предметы в окне поиска -->
                    <ComboBox x:Name="CmbStashCategory" DockPanel.Dock="Right" Width="200"
                              VerticalContentAlignment="Center" Margin="12,0,0,0"
                              SelectionChanged="OnStashFilterChanged"
                              ToolTip="Оставить один раздел справочника"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="12,0,0,0" Opacity="0.7" Text="Раздел:"/>
                    <TextBox x:Name="TxtStashSearch" VerticalContentAlignment="Center"
                             TextChanged="OnStashFilterChanged"
                             ToolTip="Поиск идёт по всей базе — так добавляют предмет, которого нет в списке"/>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75"
                           Text="Схрон — это просто опись: предмет и сколько его у вас. По умолчанию в списке то, что нужно для квестов и убежища, плюс всё, что вы уже отметили; чтобы добавить любой другой предмет, найдите его поиском — он ищет по всей базе. Плюс и минус меняют на единицу, в поле можно ввести число. Сколько ещё нужно и зачем — считается из этих чисел на других вкладках."/>

                <ListView x:Name="StashList" Background="White" Foreground="#FF15181B"
                          GridViewColumnHeader.Click="OnColumnHeaderClick">
                    <!-- раскладка по разделам: искать глазами в общем списке из
                         тысячи строк невозможно -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Margin="4,10,0,4" Foreground="#FF3A4652"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Предмет" Width="420"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Есть" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="−" Width="26" Tag="{Binding}"
                                                    Click="OnStashMinusClick"/>
                                            <TextBox Width="52" Margin="4,0" TextAlignment="Center"
                                                     Text="{Binding Have, Mode=OneWay}"
                                                     Tag="{Binding}"
                                                     LostFocus="OnStashCountEdited"
                                                     KeyDown="OnStashCountKeyDown"/>
                                            <Button Content="+" Width="26" Tag="{Binding}"
                                                    Click="OnStashPlusClick"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <TabItem x:Name="TabStations" Header="Убежище">
            <DockPanel Margin="10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkHideBuilt" DockPanel.Dock="Right" VerticalAlignment="Center"
                              Margin="12,0,0,0" Content="Скрыть достроенные"
                              Checked="OnStationFilterChanged" Unchecked="OnStationFilterChanged"
                              ToolTip="Убрать станции, у которых построен последний уровень"/>
                    <CheckBox x:Name="ChkOnlyBuildable" VerticalAlignment="Center"
                              Content="Только то, что можно строить сейчас"
                              Checked="OnStationFilterChanged" Unchecked="OnStationFilterChanged"
                              ToolTip="Оставить станции, у которых выполнены условия по другим постройкам"/>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.7"
                           Text="Уровень ставится вручную или сканированием убежища (F10). Выберите станцию, чтобы увидеть, что нужно на следующий уровень: сколько уже лежит в схроне и сколько осталось найти."/>

                <!-- что нужно выбранной станции: у списка без этого видно только уровень -->
                <Border DockPanel.Dock="Right" Width="360" Margin="8,0,0,0" Padding="10"
                        Background="#F2F4F6" BorderBrush="#D8DEE4" BorderThickness="1"
                        TextElement.Foreground="#FF15181B"
                        CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="TxtStationTitle" FontWeight="SemiBold" FontSize="14"
                                       TextWrapping="Wrap" Text="Выберите станцию в списке"/>
                            <TextBlock x:Name="TxtStationMeta" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Opacity="0.75"/>
                            <TextBlock x:Name="TxtStationBlockers" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="#FFC62828"/>
                            <TextBlock x:Name="TxtStationNeedsTitle" Margin="0,12,0,4"
                                       FontWeight="SemiBold" Text="Нужно на следующий уровень:"
                                       Visibility="Collapsed"/>
                            <ItemsControl x:Name="StationNeeds">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                                                       Text="{Binding Status}"
                                                       Foreground="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <ListView x:Name="StationsList" Background="White" Foreground="#FF15181B"
                          SelectionChanged="OnStationSelected">
                    <ListView.View>
                        <GridView>
                            <!-- зелёная галочка у подтверждённых станций, красный крестик у
                                 остальных; нажатие подтверждает текущее значение вручную -->
                            <GridViewColumn Header="" Width="34">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding StatusGlyph}"
                                                Foreground="{Binding StatusBrush}"
                                                FontWeight="Bold" FontSize="15" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Click="OnStationCheckClick"
                                                ToolTip="Отметить проверенным сейчас — для станций, которых в игре не видно"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Станция" Width="230"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Построен" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding LevelOptions}"
                                                  SelectedItem="{Binding CurrentLevel, Mode=TwoWay}"
                                                  Width="60"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Дальше" Width="90"
                                            DisplayMemberBinding="{Binding NextText}"/>
                            <GridViewColumn Header="Собрано" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ReadyText}"
                                                   Foreground="{Binding ReadyBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Отмечен" Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CheckedAt}"
                                                   Foreground="{Binding StatusBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <TabItem Header="Настройки">
            <!-- страница длиннее окна: без прокрутки нижние настройки недоступны -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="12" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock FontWeight="SemiBold" FontSize="14" Text="База данных (tarkov.dev)"/>
                <TextBlock x:Name="TxtDataStatus" Margin="0,4,0,6" TextWrapping="Wrap"/>
                <Button x:Name="BtnRefresh" Content="Обновить данные" Width="180"
                        HorizontalAlignment="Left" Click="OnRefreshClick"/>

                <Separator Margin="0,14"/>

                <TextBlock FontWeight="SemiBold" FontSize="14" Text="Папка игры (для авто-отметки квестов по логам)"/>
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Обзор…" Width="90" Margin="8,0,0,0"
                            Click="OnBrowseGamePath"/>
                    <TextBox x:Name="TxtGamePath" VerticalContentAlignment="Center"
                             LostFocus="OnGamePathChanged"/>
                </DockPanel>
                <TextBlock x:Name="TxtWatcherStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <Button x:Name="BtnImportLogs" Margin="0,8,0,0" Width="280" HorizontalAlignment="Left"
                        Content="Импортировать прогресс из логов игры"
                        Click="OnImportLogsClick"/>
                <CheckBox x:Name="ChkScanRegion" Margin="0,10,0,0"
                          Content="Подсвечивать область сканирования (для F9 и F10)"
                          Checked="OnScanRegionChanged" Unchecked="OnScanRegionChanged"/>
                <TextBlock Margin="20,2,0,0" TextWrapping="Wrap" Opacity="0.7"
                           Text="Рамка показывает, какой участок экрана ушёл в распознавание. Удобно при настройке, в бою можно выключить."/>

                <TextBlock Text="Облачное распознавание" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <CheckBox x:Name="ChkYandexOcr" Content="Помогать распознаванию через Yandex Vision OCR"
                          Checked="OnYandexOcrChanged" Unchecked="OnYandexOcrChanged"/>
                <TextBlock Margin="20,2,0,0" TextWrapping="Wrap" Opacity="0.7"
                           Text="Списки квестов (F11) читаются облаком сразу: встроенный движок коверкает короткие русские названия. Предмет под курсором (F9) уходит в облако только тогда, когда встроенный не справился, — так ответ остаётся мгновенным."/>
                <TextBlock Margin="20,2,0,0" TextWrapping="Wrap" Opacity="0.7"
                           Text="Встроенный движок Windows на коротких русских названиях ошибается дорого: «БАДы» он читает как «6AAbl». Облачный читает кириллицу точнее. Включается только для списков квестов (F11) — снимок этой области уходит в облако Яндекса; подсказки по предметам (F9) он не касается, там важнее мгновенный ответ. Нужен платёжный аккаунт: без него ключ создастся, но каждый запрос будет отклонён. Один кадр стоит около 13 копеек, запросы идут не чаще одного в секунду."/>
                <Grid Margin="20,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="API-ключ:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <PasswordBox x:Name="TxtYandexKey" Grid.Column="1" Margin="0,0,0,4"
                                 PasswordChanged="OnYandexKeyChanged"/>
                    <TextBlock Text="Каталог:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DockPanel Grid.Row="1" Grid.Column="1">
                        <Button x:Name="BtnYandexTest" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                                Content="Проверить" Click="OnYandexTestClick"/>
                        <TextBox x:Name="TxtYandexFolder" VerticalContentAlignment="Center"
                                 TextChanged="OnYandexFolderChanged"
                                 ToolTip="Идентификатор каталога (не облака!) — в консоли: информация об облаке → таблица «Каталоги», либо в адресе после /folders/"/>
                    </DockPanel>
                </Grid>
                <TextBlock x:Name="TxtYandexStatus" Margin="20,4,0,0" TextWrapping="Wrap" Opacity="0.7"/>

                <TextBlock Text="Обновление" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock x:Name="TxtUpdateStatus" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="BtnCheckUpdate" Width="180" Content="Проверить обновления"
                            Click="OnCheckUpdateClick"/>
                    <Button x:Name="BtnInstallUpdate" Width="200" Margin="8,0,0,0"
                            Content="Обновить и перезапустить" Visibility="Collapsed"
                            Click="OnInstallUpdateClick"/>
                </StackPanel>

                <TextBlock Text="Горячие клавиши" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Предмет под курсором:" Width="180" VerticalAlignment="Center"/>
                    <Button x:Name="BtnItemHotkey" Width="150" Content="F9"
                            Click="OnItemHotkeyClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Убежище:" Width="180" VerticalAlignment="Center"/>
                    <Button x:Name="BtnHideoutHotkey" Width="150" Content="F10"
                            Click="OnHideoutHotkeyClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Список квестов:" Width="180" VerticalAlignment="Center"/>
                    <Button x:Name="BtnQuestHotkey" Width="150" Content="F11"
                            Click="OnQuestHotkeyClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Сводка по локации:" Width="180" VerticalAlignment="Center"/>
                    <Button x:Name="BtnRaidHotkey" Width="150" Content="F8"
                            Click="OnRaidHotkeyClick"/>
                </StackPanel>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7"
                           Text="Нажмите кнопку, затем любую клавишу или кнопку мыши (колёсико, боковые), чтобы переназначить. Esc отменяет. Выбирайте то, что не используется в игре: клавиша перехватывается глобально, а кнопка мыши работает параллельно с игровым действием."/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7"
                           Text="Импорт находит в логах игры все сообщения о сдаче квестов и отмечает их выполненными. Логи хранятся не вечно: квесты, сданные до самой старой записи в логах, отметь вручную на вкладке «Квесты». Пока приложение запущено, новые сдачи подхватываются автоматически."/>

                <Separator Margin="0,14"/>

                <TextBlock FontWeight="SemiBold" FontSize="14" Text="Оверлей"/>
                <TextBlock x:Name="TxtHotkeyStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <!-- тексты подставляются в коде: клавиши переназначаемые -->
                <TextBlock x:Name="TxtItemHelp" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7"/>
                <TextBlock x:Name="TxtHideoutHelpTitle" Margin="0,8,0,0" TextWrapping="Wrap"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtHideoutHelp" Margin="12,4,0,0" TextWrapping="Wrap" Opacity="0.8"/>
                <TextBlock x:Name="TxtQuestHelpTitle" Margin="0,8,0,0" TextWrapping="Wrap"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtQuestHelp" Margin="12,4,0,0" TextWrapping="Wrap" Opacity="0.8"/>
                <TextBlock x:Name="TxtOcrStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
  </DockPanel>
</Window>
