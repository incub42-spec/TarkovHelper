<Window x:Class="TarkovHelper.ItemSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico"
        Title="Зачем нужен предмет"
        Width="920" Height="600"
        Background="#FFF7F8FA" Foreground="#FF15181B"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock x:Name="TxtTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="TxtSummary" DockPanel.Dock="Top" Opacity="0.75" Margin="0,4,0,8"
                   TextWrapping="Wrap"/>

        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Width="110" Margin="0,10,0,0"
                Content="Закрыть" IsCancel="True"/>

        <!-- варианты одной записи: у жетонов они различаются только английским
             названием и ценой, поэтому таблица появляется лишь когда их больше одного -->
        <DockPanel x:Name="PanelVariants" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Text="Варианты в базе" FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <ListView x:Name="ListVariants" Height="130"
                      Background="White" Foreground="#FF15181B">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Название в базе" Width="360"
                                        DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="В схроне" Width="90"
                                        DisplayMemberBinding="{Binding Have}"/>
                        <GridViewColumn Header="Барахолка" Width="110"
                                        DisplayMemberBinding="{Binding Price}"/>
                        <GridViewColumn Header="Торговец" Width="200"
                                        DisplayMemberBinding="{Binding TraderPrice}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <ListView x:Name="ListSources" Background="White" Foreground="#FF15181B">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Откуда" Width="90"
                                    DisplayMemberBinding="{Binding Kind}"/>
                    <GridViewColumn Header="Источник" Width="480">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Source}" Foreground="{Binding Brush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Нужно" Width="150"
                                    DisplayMemberBinding="{Binding Count}"/>
                    <GridViewColumn Header="Только FIR" Width="90"
                                    DisplayMemberBinding="{Binding Fir}"/>
                    <GridViewColumn Header="Когда" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding When}" Foreground="{Binding Brush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
