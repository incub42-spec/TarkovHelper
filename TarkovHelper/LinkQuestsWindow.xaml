<Window x:Class="TarkovHelper.LinkQuestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico"
        Title="Нераспознанные строки"
        Width="820" Height="560"
        Background="#FFF7F8FA" Foreground="#FF15181B"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                   Text="Это строки списка заданий, которые сканирование прочитало, но не нашло в базе: локаль отстаёт от игры, и часть квестов там называется иначе. Выберите строку и квест, которому она принадлежит, — имя запомнится в профиле и переживёт обновление базы."/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="BtnForget" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"
                    Content="Убрать строку" Click="OnForgetClick"
                    ToolTip="Строка не относится к заданиям базы — например, событийное задание"/>
            <Button x:Name="BtnLink" DockPanel.Dock="Right" Width="150"
                    Content="Связать" Click="OnLinkClick" IsDefault="True"/>
            <TextBlock x:Name="TxtHint" VerticalAlignment="Center" Opacity="0.75"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Прочитано в игре" FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ListBox x:Name="ListRows" Background="White" Foreground="#FF15181B"
                         SelectionChanged="OnRowSelected"/>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Квест в базе" FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtSearch" DockPanel.Dock="Top" Margin="0,0,0,4"
                         VerticalContentAlignment="Center" TextChanged="OnSearchChanged"
                         ToolTip="Поиск по названию"/>
                <ListBox x:Name="ListQuests" Background="White" Foreground="#FF15181B"
                         DisplayMemberPath="Title"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
