<Window x:Class="TarkovHelper.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico"
        Title="Профиль персонажа"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="#FFF7F8FA" Foreground="#FF15181B"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock x:Name="LblName" Text="Название профиля:" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtName" Text="Новый персонаж"/>

        <StackPanel x:Name="PanelMode" Margin="0,12,0,0">
            <TextBlock Text="Режим игры:" Margin="0,0,0,4"/>
            <RadioButton x:Name="RadioPve" Content="PvE" IsChecked="True"/>
            <RadioButton x:Name="RadioPvp" Content="PvP" Margin="0,4,0,0"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7"
                       Text="У PvE и PvP разные наборы квестов и цены, поэтому прогресс хранится отдельно. Позже режим профиля изменить нельзя."/>
        </StackPanel>

        <StackPanel x:Name="PanelDetails" Margin="0,12,0,0">
            <TextBlock Text="Фракция:" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbFaction" Width="150" HorizontalAlignment="Left"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7"
                       Text="У части квестов две версии — для USEC и для BEAR. Пока фракция не указана, показываются обе."/>

            <TextBlock Text="Уровень ЧВК:" Margin="0,12,0,4"/>
            <TextBox x:Name="TxtLevel" Width="80" HorizontalAlignment="Left"
                     TextAlignment="Center"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7"
                       Text="Квесты с требованием выше уровня считаются закрытыми. Пусто — не учитывать."/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="ОК" Width="90" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Отмена" Width="90" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
