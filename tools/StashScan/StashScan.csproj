<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StashScan</AssemblyName>
    <RootNamespace>StashScan</RootNamespace>
    <!-- разбору нужны только картинки WPF, окон тут нет -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- берём боевой разбор: проверяем ровно то, что стоит за кнопкой -->
  <ItemGroup>
    <Compile Include="..\..\TarkovHelper\Models\GameData.cs" Link="GameData.cs" />
    <Compile Include="..\..\TarkovHelper\Models\Progress.cs" Link="Progress.cs" />
    <Compile Include="..\..\TarkovHelper\Models\Need.cs" Link="Need.cs" />
    <Compile Include="..\..\TarkovHelper\Services\StashScanner.cs" Link="StashScanner.cs" />
    <Compile Include="..\..\TarkovHelper\Services\YandexOcr.cs" Link="YandexOcr.cs" />
  </ItemGroup>

</Project>
